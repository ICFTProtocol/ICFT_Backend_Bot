# Testnet-only ICFT liquidation keeper. Never reuse deployer or upgrade-admin keys.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Deployed Sepolia contracts
ICFT_ADDRESS=0xd3607F62dE598546e11f2C7bA8f3fDE042F652fa
LENDING_POOL_ADDRESS=0xAA34c13F7932eBb77dA286F35Dc95aA13CD7626A
LIQUIDATION_ENGINE_ADDRESS=0x85f6B6a0a384f5DB28E972b91D97Cd7aC1e0980e
WBTC_ADDRESS=0x29f2D40B0605204364af54EC677bD022dA425d03

# Historical borrower discovery. Set this to the LendingPool deployment block.
START_BLOCK=11799163
LOG_BATCH_SIZE=2000
POLL_INTERVAL_MS=15000
STATE_FILE=./data/keeper-state.json

# Dry run is the default and must remain true until role/funding tests are complete.
EXECUTION_ENABLED=false
ALLOW_LIVE_TESTNET_EXECUTION=false
OPERATOR_PRIVATE_KEY=
COLLATERAL_BENEFICIARY=
MAX_ICFT_PER_LIQUIDATION=1000
